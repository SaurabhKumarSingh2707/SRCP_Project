generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  FACULTY
  INDUSTRY
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  LOCKED
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamStatus {
  FORMING
  REQUESTED_GUIDE
  APPROVED
}

model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName       String
  email          String?       @unique
  registerNumber String?       @unique
  dateOfBirth    DateTime?     @db.Date
  password       String?
  role           Role          @default(STUDENT)
  profilePhoto   String?
  accountStatus  AccountStatus @default(PENDING)

  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  refreshToken        String?
  session             Session?

  studentProfile  StudentProfile?
  facultyProfile  FacultyProfile?
  industryProfile IndustryProfile?
  adminProfile    AdminProfile?

  notifications Notification[] @relation("UserNotifications")

  teamsLed        Team[]       @relation("TeamLeader")
  teamMemberships TeamMember[]
  guidedTeams     Team[]       @relation("TeamGuide")

  facultyGuideSlot FacultyGuideSlot?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([role, accountStatus])
  @@index([email])
  @@index([registerNumber])
  @@index([createdAt])
}

model StudentProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  batch                String?
  department           String?
  yearOfStudy          String?
  section              String?
  bio                  String?
  skills               String[]
  programmingLanguages String[]
  projectsCompleted    Int?
  githubLink           String?
  resumeFile           String?
  areasOfInterest      String[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([department])
}

model FacultyProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId        String?
  department        String?
  designation       String?
  researchAreas     String[]
  yearsOfExperience Int?
  skills            String[]
  contactNumber     String?
  linkedin          String?
  bio               String?

  projects     Project[] @relation("FacultyProjects")
  pastProjects String[]  @default([])
  projectIdeas ProjectIdea[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model IndustryProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String?
  designation String?
  bio         String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model AdminProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  department String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Project {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  domain           String?
  problemStatement String?
  description      String
  technologies     String[]
  expectedOutcome  String?
  skillsRequired   String[]
  numberOfStudents Int?
  status           ProjectStatus @default(OPEN)
  deadline         DateTime?     @db.Timestamptz(6)

  proposalFile      String?
  documentationFile String?
  demoFile          String?
  imageFiles        String[]

  facultyId String         @db.Uuid
  faculty   FacultyProfile @relation("FacultyProjects", fields: [facultyId], references: [id], onDelete: Cascade)

  teams      Team[]
  milestones Milestone[] @relation("ProjectMilestones")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([facultyId])
  @@index([status])
  @@index([createdAt])
}

model Team {
  id              String           @id
  name            String
  description     String?
  domain          String?
  projectId       String?          @db.Uuid
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status          TeamStatus       @default(FORMING)

  leaderId        String           @db.Uuid
  leader          User             @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)

  guideId         String?          @db.Uuid
  guide           User?            @relation("TeamGuide", fields: [guideId], references: [id], onDelete: SetNull)

  selectionSource String           @default("STUDENT") // STUDENT or FACULTY

  members         TeamMember[]
  abstractFile    String?

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@index([projectId])
  @@index([leaderId])
  @@index([guideId])
  @@index([status])
  @@index([createdAt])
}

model TeamMember {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isLeader     Boolean      @default(false)
  inviteStatus InviteStatus @default(PENDING)

  joinedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([teamId, userId])
  @@index([userId])
}

model Milestone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  dueDate     DateTime @db.Timestamptz(6)
  status      String   @default("PENDING") // PENDING, SUBMITTED, COMPLETED
  projectId   String   @db.Uuid
  project     Project  @relation("ProjectMilestones", fields: [projectId], references: [id], onDelete: Cascade)

  submissionNotes String?
  submissionFile  String?
  submittedAt     DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([projectId])
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  type      String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([read, type])
}

model FacultyGuideSlot {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId  String @unique @db.Uuid
  faculty    User   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  totalSlots Int    @default(7)
  usedSlots  Int    @default(0)
}

model Session {
  id        String   @id
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([userId])
}

model SystemConfig {
  id                            String  @id @default("singleton")
  isResearchCollaborationActive Boolean @default(true)
  isTeamCreationEnabled         Boolean @default(true)
}

model GuideSelectionConfig {
  id        String   @id @default("singleton")
  phase     String   @default("CLOSED")
  updatedAt DateTime @updatedAt
}

model GlobalMilestone {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String
  dueDate      DateTime @db.Timestamptz(6)
  status       String   @default("PENDING")
  relatedPhase String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
}

model ProjectIdea {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String
  description           String
  suggestedTechnologies String[]
  difficultyLevel       String?
  skillsRequired        String[]
  numberOfStudents      Int?
  supportingFile        String?

  facultyId             String         @db.Uuid
  faculty               FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)

  @@index([facultyId])
  @@index([createdAt])
}
